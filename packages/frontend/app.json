{
  "expo": {
    "name": "Oxy Pay",
    "slug": "oxypay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "oxypay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.oxy.pay"
    },
    "android": {
      "package": "co.oxy.pay",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0B0B0B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
