# Oxy Pay backend
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/oxypay
MONGODB_DB_NAME=oxypay

# Oxy API (for user JWT verification + service tokens to act on behalf of users)
OXY_API_BASE_URL=https://api.oxy.so
OXY_PAY_INTERNAL_APP_KEY=oxy_dk_...
OXY_PAY_INTERNAL_APP_SECRET=...

# FairCoin node (optional in dev — see services/faircoin.service.ts for mock mode)
FAIRCOIN_RPC_URL=http://localhost:40404
FAIRCOIN_RPC_USER=
FAIRCOIN_RPC_PASSWORD=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,https://pay.oxy.so
