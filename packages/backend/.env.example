# Oxy Pay backend
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/oxypay
MONGODB_DB_NAME=oxypay

# Oxy API (for user JWT verification + service tokens to act on behalf of users)
OXY_API_BASE_URL=https://api.oxy.so
OXY_PAY_INTERNAL_APP_KEY=oxy_dk_...
OXY_PAY_INTERNAL_APP_SECRET=...

# FairCoin node — LEAVE UNSET for mock mode. The live integration goes live only
# when BOTH FAIRCOIN_RPC_PASS and FAIRCOIN_MASTER_MNEMONIC are set. Until then
# getDepositAddress/estimateWithdrawalFee run in mock mode and broadcastWithdrawal
# refuses (503). Note port 46373 — 46372 is the P2P port. Secrets go to SSM, not git.
# FAIRCOIN_RPC_HOST=seed1.fairco.in
# FAIRCOIN_RPC_PORT=46373
# FAIRCOIN_RPC_USER=faircoinrpc
# FAIRCOIN_RPC_PASS=
# FAIRCOIN_RPC_SCHEME=http
#
# SENSITIVE — custodial hot-wallet master seed (BIP39). NEVER commit a real
# value, NEVER log it. The full custodial balance derives from this phrase; treat
# it like the keys to the vault. Store only in SSM / a secrets manager.
# FAIRCOIN_MASTER_MNEMONIC=
#
# Network selection: mainnet (default) or testnet.
# FAIRCOIN_NETWORK=mainnet
#
# Confirmations required before a deposit is credited / a coin is spent.
# FAIRCOIN_MIN_CONFIRMATIONS=6
#
# Deposit watcher poll interval (ms) and on/off switch (defaults to on when live).
# FAIRCOIN_WATCHER_INTERVAL_MS=60000
# FAIRCOIN_WATCHER_ENABLED=true
#
# Fallback feerate (base units per byte) used when estimatesmartfee is unavailable.
# FAIRCOIN_FALLBACK_FEERATE_SATS_PER_BYTE=10

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,https://pay.oxy.so
